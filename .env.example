# AI 自动开发系统 - 环境变量配置（精简版）
#
# 权威模板是 backend/.env.example（字段完整），推荐做法：
#     cp backend/.env.example backend/.env
# backend/.env 中的非空值会覆盖本文件对应的同名变量（见 backend/config.py）。
# 本文件只保留从项目根目录启动时最基础的几项。

# ============ LLM 配置 ============
# API 格式：anthropic / openai / cli。代码默认值是 anthropic，
# 下面给的是 OpenAI 兼容地址，所以这里必须显式写 openai，否则格式和地址对不上。
LLM_API_FORMAT=openai
# OpenAI 兼容 API 地址（必填，否则使用规则引擎降级）
LLM_BASE_URL=https://api.openai.com/v1
# API Key（必填）
LLM_API_KEY=sk-your-api-key-here
# 模型名称
LLM_MODEL=gpt-4
# 超时秒数
LLM_TIMEOUT=60
# 最大重试次数
LLM_MAX_RETRIES=3

# ============ 服务配置 ============
# 默认只监听本机；全部 API 没有鉴权，仅在可信网络内才改成 0.0.0.0
HOST=127.0.0.1
PORT=8000
DEBUG=true
