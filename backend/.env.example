# ── 服务器 ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
# 用户级 ConfigPack 安装（写 ~/.claude/ 等主目录）：默认关闭。
# 开启后 /api/projects/packs/user/* 仍仅接受本机请求；非必要不要开。
USER_PACK_INSTALL_ENABLED=false

# ── 数据库 ──────────────────────────────────────────────────────────────────
DB_PATH=./data/ai_dev_system.db

# ── LLM API 模式（anthropic / openai）────────────────────────────────────────
# 与 CLI 模式二选一，两套配置可并存，通过 LLM_API_FORMAT 切换
LLM_API_FORMAT=anthropic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ── LLM CLI 模式（LLM_API_FORMAT=cli 时生效）─────────────────────────────────
# cli_type: claude / codebuddy / cursor / custom
# cli_cmd:  工具在 PATH 中可直接写名称，否则填完整路径（Windows 含 .exe）
# cli_model: 留空则复用 LLM_MODEL；各工具支持的模型名称以官方文档为准
# cli_timeout: 子进程最大等待秒数，复杂任务可适当调大
#
# LLM_API_FORMAT=cli
# LLM_CLI_TYPE=claude
# LLM_CLI_CMD=claude
# LLM_CLI_MODEL=
# LLM_CLI_TIMEOUT=120
#
# CodeBuddy 示例：
# LLM_API_FORMAT=cli
# LLM_CLI_TYPE=codebuddy
# LLM_CLI_CMD=codebuddy
# LLM_CLI_MODEL=
# LLM_CLI_TIMEOUT=120
#
# Cursor Agent 示例（需已安装并登录：agent / cursor-agent）：
# LLM_API_FORMAT=cli
# LLM_CLI_TYPE=cursor
# LLM_CLI_CMD=agent
# LLM_CLI_MODEL=auto
# LLM_CLI_TIMEOUT=120

# ── 预算约束 ─────────────────────────────────────────────────────────────────
AGENT_MAX_TOKENS=200000
AGENT_MAX_TURNS=50
AGENT_MAX_SECONDS=600
CHAT_MAX_TOKENS=300000
CHAT_MAX_TURNS=50
CHAT_MAX_SECONDS=300

# ── 知识库 / 资产库（可选）───────────────────────────────────────────────────
# GLOBAL_KNOWLEDGE_REPO_URL=https://github.com/your-org/G_DesignKnowledge.git
# GLOBAL_KNOWLEDGE_LOCAL_PATH=./G_DesignKnowledge
# GLOBAL_KNOWLEDGE_AUTO_PUSH=false
# ART_ASSETS_REPO_URL=https://github.com/your-org/G_ArtRes.git
# ART_ASSETS_LOCAL_PATH=./G_ArtRes
# ART_ASSETS_AUTO_PUSH=false

# ── 图片生成（可选）──────────────────────────────────────────────────────────
# LIGHTAI_API_BASE=https://api.lightai.woa.com
# LIGHTAI_API_KEY=
# LIGHTAI_IMAGE_ENGINE=gemini
# LIGHTAI_IMAGE_TIMEOUT=300
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ── 系统公共云端生视频：MiniMax H3（可选，供多个 Plugin 适配调用）──────────
# ⚠️ 第三方「鼠鼠工具」卡密中转（runlive.top），不是 MiniMax 官方 API。
# 卡密钥需管理员白名单放行；官方 api_key + GroupID 不能填在这里。
# 配置属于 ADS 系统层（backend/cloud_video/），不在任何 Plugin 目录内。
# 真实 key 只写 backend/.env，不要提交。
# MINIMAX_H3_BASE_URL=https://www.runlive.top/mnmx
# MINIMAX_H3_CARD_KEY=sk_...
# MINIMAX_H3_ENABLED=false
# MINIMAX_H3_TIMEOUT=120
# MINIMAX_H3_POLL_INTERVAL=5
# MINIMAX_H3_MAX_POLLS=180
#
# 生成任务排队（时段感知 FIFO 信号量，参考 ComicAI）：闲时 0-8 点最多 5 个任务
# 在排队/生成，白天不限；一个名额覆盖「提交+轮询」全程，排队超时转 blocked。
# 时区必须显式配（服务端不能用浏览器本地时区）；ZoneInfo 不可用时按 TZ_OFFSET 回退。
# MINIMAX_H3_QUEUE_ENABLED=true
# MINIMAX_H3_QUEUE_IDLE_LIMIT=5
# MINIMAX_H3_QUEUE_IDLE_START=0
# MINIMAX_H3_QUEUE_IDLE_END=8
# MINIMAX_H3_QUEUE_TZ=Asia/Shanghai
# MINIMAX_H3_QUEUE_TZ_OFFSET=8
# MINIMAX_H3_QUEUE_WAIT_TIMEOUT=900

# ── VideoClaw sidecar（可选，独立进程 REST+SSE）──────────────────────────────
# 先在 VC 仓库的 backend/ 下准备 config.yaml（端口改 8100、填 dashscope/ark Key），
# 再 `cd backend && uv run python api_server.py` 起服务，最后把 ENABLED 置 true。
# 未启用时 plugins/videoclaw/ 返回 env_missing → blocked，不会触发 DevAgent 返工。
# VIDEOCLAW_BASE_URL=http://127.0.0.1:8100
# VIDEOCLAW_TIMEOUT=600
# VIDEOCLAW_VIDEO_TIMEOUT=900
# VIDEOCLAW_ENABLED=false
